{
  "name": "sophia-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev/db.mjs start --if-local && next dev",
    "prebuild": "tsx --conditions=react-server scripts/seed.ts --prebuild",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lighthouse": "node scripts/dev/lighthouse.mjs",
    "setup": "npm run db:start && npm run db:migrate && npm run db:seed",
    "db:start": "node scripts/dev/db.mjs start",
    "db:stop": "node scripts/dev/db.mjs stop",
    "db:status": "node scripts/dev/db.mjs status",
    "db:reset": "node scripts/dev/db.mjs reset",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "ingest": "tsx --conditions=react-server scripts/ingest.ts",
    "sources": "tsx --conditions=react-server scripts/sources.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@mozilla/readability": "^0.6.0",
    "drizzle-orm": "^0.45.3",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "next": "16.3.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rss-parser": "^3.13.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^17.10.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "lighthouse": "^13.5.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.2"
  }
}
