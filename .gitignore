# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# wiege: local embedded Postgres data and logs
/data/

# wiege: env template is committed (the .env* rule above ignores it otherwise)
!.env.example

# wiege: Lighthouse reports
/.lighthouse/

# wiege: Playwright artefacts
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# wiege: throwaway QA scripts written by build agents, and Netlify CLI state
/.tmp-*
/.netlify/
