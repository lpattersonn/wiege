# Wiege environment variables (SPEC §12). Copy to .env.local for local overrides.
# Never commit real values. Empty values are treated as "not set".

# --- Database ---------------------------------------------------------------
# Postgres connection used by the app (server-side only).
# Production (Supabase transaction pooler, port 6543), e.g.
#   postgresql://<user>.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require
# Leave unset in development: the app then uses the local embedded Postgres
# started by `npm run db:start` (postgres://postgres:postgres@localhost:54329/wiege).
DATABASE_URL=

# Optional connection for migrations (Supabase session pooler, port 5432, same
# credentials). Falls back to DATABASE_URL.
MIGRATION_DATABASE_URL=

# Production values may be kept locally as WIEGE_SUPABASE_DATABASE_URL and
# WIEGE_SUPABASE_MIGRATION_URL. They are deliberately not named DATABASE_URL, so
# development never touches production by accident; the app never reads them.

# Provisioning only (Supabase CLI / Management API). Never read by the app.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Build: set to 1 to let `prebuild` (migrate + seed) skip when no database is
# reachable, e.g. a CI build without database access. Pages then render empty states.
WIEGE_SKIP_DB_PREBUILD=

# Apply pending migrations when the server boots (instrumentation.ts): 1 or 0.
# Empty (default): on for `next start` / self-hosting, off on Netlify/Vercel,
# where the build's `prebuild` step migrates and cold starts should stay fast.
WIEGE_AUTO_MIGRATE=

# --- News ingestion -----------------------------------------------------------
# Shared secret for GET|POST /api/cron/ingest (Authorization: Bearer <secret>).
# At least 16 characters, e.g. `openssl rand -hex 32`. Not needed on localhost in development.
CRON_SECRET=

# In-process 4-hour scheduler for self-hosting: 1 (default) or 0. Ignored on
# serverless hosts (Netlify, Vercel), which use their own schedulers.
# In development it also runs one catch-up ingest ~30 s after `next dev` starts
# when the last run is older than 4 hours; set WIEGE_SCHEDULER=0 in .env.local
# if you do not want live news fetched while you work.
WIEGE_SCHEDULER=1

# Time budget per cron-triggered ingest run in ms. Leave empty for the default:
# 20000 on Netlify/Vercel (serverless time limits), unlimited elsewhere.
WIEGE_INGEST_BUDGET_MS=

# --- AI (optional) ----------------------------------------------------------------
# Claude API key. Without it Wiege uses its offline heuristic lesson and feedback engine.
ANTHROPIC_API_KEY=

# Alternative to ANTHROPIC_API_KEY (a bearer auth token). The key wins when both are set.
ANTHROPIC_AUTH_TOKEN=

# Claude model id. Default claude-opus-5.
WIEGE_AI_MODEL=claude-opus-5

# Global daily cap on AI writing-feedback calls. Default 2000.
WIEGE_FEEDBACK_DAILY_CAP=2000

# --- Privacy & site -----------------------------------------------------------------
# Salt for hashing client IPs in rate-limit keys (IPs are never stored raw).
# At least 16 random characters, e.g. `openssl rand -hex 32`. Required in production.
WIEGE_IP_SALT=

# Public origin of the site (canonical URLs, Open Graph, POST origin checks).
WIEGE_SITE_URL=http://localhost:3000

# Contact address shown on /parents.
WIEGE_CONTACT_EMAIL=
